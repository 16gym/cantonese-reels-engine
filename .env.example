# Copy to .env and fill in. Never paste keys into chat and never show this file on screen.
# A key is not permission to spend: every budget is still approved by you through `reels money`.

# How the engine reaches Higgsfield:
#   cli  = the official Higgsfield CLI, spends your plan credits (Plus or above). Log in once: higgsfield auth login
#   rest = the pay-as-you-go API, a separate prepaid balance; needs the two HF_API_KEY_* lines below
REELS_PROVIDER=cli
HF_API_KEY_ID=
HF_API_KEY_SECRET=

# Kie AI key, only for the 4K upscale at the end (reels upscale).
KIE_API_KEY=

# ElevenLabs key, only to read your own voice once as a character's voice sample
# (reels voice-lock --eleven <voice id>). The key needs the Text to Speech permission.
ELEVENLABS_API_KEY=

# A website or email you are happy to show Wikimedia. Their robot policy refuses photo
# searches from clients that give no contact. Leave empty to skip photo search.
REELS_CONTACT=
